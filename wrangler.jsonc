{
  // Dilam B' — configuration Cloudflare. Aucun secret ici : les clés se saisissent dans le tableau de bord.
  "name": "sell-app",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/media/*", "/", "/ebook/*", "/telecharger/*", "/sitemap.xml"],
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "dilamboutique-db", "database_id": "881344fb-7c07-422b-b4fd-960dbff73c73" }
  ],
  "kv_namespaces": [
    { "binding": "FILES", "id": "fd6111635b76429fa548ca2718093496" }
  ],
  // Toutes les heures : relance des paiements abandonnés ; à 18 h UTC (18 h à Abidjan) : relances du test d'alignement.
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
